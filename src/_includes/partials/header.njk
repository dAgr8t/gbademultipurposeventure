<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href=" /" aria-label="{{ site.name }} home">
      <img src="{{ site.logo }}" alt="{{ site.name }} logo">

    </a>
    <nav class="nav-links" id="primary-navigation" aria-label="Main navigation">
      {%- for item in site.nav %}
      <a href="{{ item.href }}" {% if item.href=page.url %} class="active" aria-current="page" {% endif %}>{{
        item.label }}</a>
      {%- endfor %}
      <a class="mobile-quote" href="{{ site.quoteHref }}">Request a Quote ↗</a>
    </nav>
    <a class="btn btn-blue nav-quote" href="{{ site.quoteHref }}">Request a Quote <span>↗</span></a>
    <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false"
      aria-label="Open navigation menu">☰</button>
  </div>
</header>